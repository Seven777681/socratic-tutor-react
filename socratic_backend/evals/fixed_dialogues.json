    {
      "id": "repetition-avoid-same-intent",
      "category": "repetition",
      "title": "Tutor does not rephrase the same question repeatedly",
      "task_id": "qb-first-while-loop",
      "input": {
        "ui_language": "en",
        "stage": "debug",
        "current_focus": "logical_error",
        "hint_level": 2,
        "conversation": [
          {"role": "tutor", "content": "What changes the value of number during each loop iteration?"},
          {"role": "student", "content": "I do not know."},
          {"role": "tutor", "content": "Which statement updates number before the condition is checked again?"}
        ],
        "student_message": "I still do not understand.",
        "current_code": "number = 1\nwhile number <= 3:\n    print(number)"
      },
      "expected": {
        "response_language": "en",
        "must_change_question_intent": true,
        "allowed_strategies": ["PROVIDE_EXAMPLE", "PROVIDE_PSEUDOCODE"],
        "must_not_repeat": ["what changes number", "which statement updates number"],
        "max_questions": 1,
        "must_not_reveal_solution": true
      }
    },
