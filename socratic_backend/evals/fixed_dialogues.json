{
  "schema_version": 1,
  "name": "Socratic Tutor fixed dialogue regression set",
  "description": "Stable dialogue cases for evaluating language, learning-state updates, Socratic strategy, repetition, stage progression, debugging, hints, memory use, and reflection.",
  "global_assertions": {
    "max_student_facing_questions": 1,
    "must_not_reveal_complete_solution": true,
    "must_not_claim_unseen_student_evidence": true,
    "must_preserve_python_identifiers": true,
    "must_follow_latest_student_message_language": true
  },
  "cases": [
    {
      "id": "understand-goal-correct-en",
      "category": "understanding",
      "title": "Correct goal answer advances focus",
      "task_id": "qb-find-maximum",
      "input": {
        "ui_language": "en",
        "stage": "understand",
        "current_focus": "problem_goal",
        "hint_level": 0,
        "conversation": [
          {"role": "tutor", "content": "What is the program trying to find?"}
        ],
        "student_message": "It needs to find the largest number in the input list.",
        "current_code": ""
      },
      "expected": {
        "response_language": "en",
        "answer_quality": "correct",
        "focus_must_change": true,
        "allowed_next_focus": ["input", "algorithm", "plan_submission"],
        "must_not_repeat": ["What is the program trying to find?"],
        "max_questions": 1,
        "must_not_reveal_solution": true
      }
    },
    {
      "id": "understand-goal-vague-en",
      "category": "understanding",
      "title": "Vague goal answer stays on one missing idea",
      "task_id": "qb-find-maximum",
      "input": {
        "ui_language": "en",
        "stage": "understand",
        "current_focus": "problem_goal",
        "hint_level": 0,
