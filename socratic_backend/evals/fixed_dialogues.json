        "student_message": "It processes some numbers.",
        "current_code": ""
      },
      "expected": {
        "response_language": "en",
        "answer_quality": "partial",
        "focus_must_change": false,
        "allowed_strategies": ["ASK_CONCEPTUAL", "ASK_METACOGNITIVE"],
        "max_questions": 1,
        "must_not_reveal_solution": true
      }
    },
