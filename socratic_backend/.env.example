OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-coder

DATABASE_URL=mysql+pymysql://socratic_app:replace_with_your_password@127.0.0.1:3306/socratic_tutor?charset=utf8mb4

# One-time migration target only; do not commit the real connection string.
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:password@host:5432/postgres?sslmode=require

# Required on Vercel for PostgreSQL certificate verification. Download the
# project CA certificate from Supabase Database Settings and commit that public
# certificate at this relative path (never put a private key here).
DATABASE_SSL_ROOT_CERT=certs/supabase-ca.crt

# Optional: pin study logging to one existing active session UUID.
SOCRATIC_STUDY_SESSION_ID=
