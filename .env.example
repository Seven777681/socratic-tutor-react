# Server-side only. Copy this file to .env.local; never commit the real key.
# Supported providers: openai, deepseek.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Usually leave this empty for OpenAI. DeepSeek uses https://api.deepseek.com.
LLM_BASE_URL=

# DeepSeek example:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your_deepseek_key_here
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com

# Backwards compatibility: existing OPENAI_API_KEY and OPENAI_MODEL values
# are still recognized when the generic LLM_* variables are not set.

# Python code-execution service used by /api/code/run.
SOCRATIC_BACKEND_URL=http://127.0.0.1:8001
