# Server-side only. Copy this file to .env.local and add your key there.
OPENAI_API_KEY=

# Keep this configurable so cost/latency/quality can be evaluated per Agent workload.
OPENAI_MODEL=gpt-4.1-mini

# Python code-execution service used by /api/code/run.
SOCRATIC_BACKEND_URL=http://127.0.0.1:8001
